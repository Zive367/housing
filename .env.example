# Copy to `.env` on the server and fill in. `.env` is gitignored: never commit it.
# Everything here is either a secret or personal data.

# --- Claude API (console.anthropic.com -> API keys) ---
ANTHROPIC_API_KEY=

# --- Dedicated bot mailbox: a NEW personal Gmail, never a work address ---
# Alert emails (Stekkies / Funda / Pararius / ...) are sent here, applications go out
# from here, and agents' replies come back here.
BOT_EMAIL=
# Gmail "app password" (Google account -> Security -> 2-Step Verification -> App passwords)
BOT_EMAIL_APP_PASSWORD=
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# --- Google Sheet (service account JSON key + the sheet's ID from its URL) ---
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
GOOGLE_SHEET_ID=

# --- Notifications ---
# whatsapp_cloud (official Meta API, recommended) | callmebot (free, unofficial) | email
NOTIFY_CHANNEL=whatsapp_cloud
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Your own WhatsApp number in international format without "+", e.g. 316XXXXXXXX
WHATSAPP_TO=
WHATSAPP_TEMPLATE=housing_alert
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
# Backup channel: flagged events (viewing booked, call needed) are ALSO emailed here
NOTIFY_EMAIL=

# --- You (the main applicant). Used to write application messages. ---
APPLICANT_FIRST_NAME=
APPLICANT_LAST_NAME=
# Phone number agents may call, international format, e.g. +316XXXXXXXX
APPLICANT_PHONE=
APPLICANT_AGE=
APPLICANT_JOB_TITLE=
# Optional. Leave empty to not mention your employer in messages.
APPLICANT_EMPLOYER=
# permanent | temporary | self-employed
APPLICANT_CONTRACT=permanent
APPLICANT_NATIONALITY=
# One short line, e.g. "non-smoker, no pets, quiet and tidy"
APPLICANT_ABOUT=
# Gross monthly income in EUR. Used ONLY internally (solo-vs-couple and permit checks).
# The bot never puts an amount in a message and never attaches documents.
APPLICANT_GROSS_MONTHLY_INCOME=

# --- Partner (optional; leave empty to always apply solo) ---
PARTNER_FIRST_NAME=
PARTNER_AGE=
PARTNER_JOB_TITLE=
PARTNER_CONTRACT=
PARTNER_GROSS_MONTHLY_INCOME=
